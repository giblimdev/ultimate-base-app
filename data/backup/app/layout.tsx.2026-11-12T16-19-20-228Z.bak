/*
path :           app/layout.tsx
tag :            ["layout-racine", "fonts", "providers", "socle",
                  "route-groups", "html-body"]
projectId:       <UltimateBaseApp>
type:            layout
generic:         false

role:            Layout racine de l'application. UNIQUE propriétaire de
                 <html> et <body> dans tout le projet. Charge les polices
                 Inter et JetBrains Mono, applique les variables CSS,
                 monte les providers globaux (TooltipProvider, Toaster
                 Sonner). NE MONTE PAS AppSidebar, AppHeader ni <main> :
                 le shell authentifié vit dans app/(app)/layout.tsx, et
                 le shell public dans app/(public)/layout.tsx. Cette
                 séparation garantit que /legal/* est accessible SANS
                 authentification, évite le double montage du shell, et
                 respecte la règle Next.js (un seul <html>/<body>).
                 SuppressHydrationWarning requis pour next-themes
                 (injection de script avant hydratation).

flow:            RootLayout({ children }) → <html lang="fr"> → <body> →
                 TooltipProvider → {children} → <Toaster />.

ecosystem:       Socle = [
                   "@/app/globals.css",
                   "@/app/layout.tsx",
                   "@/components/ui/tooltip.tsx",
                 ]
relatedFiles:    ["@/app/globals.css",
                  "@/app/(app)/layout.tsx",
                  "@/app/(public)/layout.tsx",
                  "@/components/ui/tooltip.tsx"]
imports:         ["next", "next/font/google", "./globals.css",
                  "@/components/ui/tooltip", "sonner"]
exports:         ["metadata", "default RootLayout"]
useBy:           ["@/app/(app)/layout.tsx", "@/app/(public)/layout.tsx"]

userStories:     ["*en tant que développeur je veux un layout racine qui monte les providers globaux sans imposer de shell",
                  "*en tant que visiteur je veux accéder aux pages publiques sans sidebar",
                  "*en tant que développeur je veux un seul <html> et <body> dans tout le projet"]
status:          wip
pathChecked:     ✔true
metaDataChecked: ✔true
scriptChecked:   ✘false
*/
import type { Metadata } from "next";
import { Inter, JetBrains_Mono } from "next/font/google";
import "./globals.css";
import { TooltipProvider } from "@/components/ui/tooltip";
import { Toaster } from "sonner";

const inter = Inter({
  variable: "--font-sans",
  subsets: ["latin"],
});

const jetbrainsMono = JetBrains_Mono({
  variable: "--font-mono",
  subsets: ["latin"],
});

export const metadata: Metadata = {
  title: "Ultimate Base App",
  description: "Plateforme de développement applicatif réutilisable",
};

export default function RootLayout({
  children,
}: {
  children: React.ReactNode;
}) {
  return (
    <html
      lang="fr"
      className={`${inter.variable} ${jetbrainsMono.variable} h-full antialiased`}
      suppressHydrationWarning
    >
      <body className="min-h-full bg-background text-foreground">
        <TooltipProvider>
          {children}
          <Toaster
            position="bottom-right"
            richColors
            closeButton
            expand
            visibleToasts={4}
            toastOptions={{
              duration: 4000,
              classNames: {
                toast: "rounded-xl shadow-lg border",
                title: "font-semibold",
                description: "text-sm opacity-90",
                actionButton: "font-medium",
                cancelButton: "font-medium",
              },
            }}
          />
        </TooltipProvider>
      </body>
    </html>
  );
}
